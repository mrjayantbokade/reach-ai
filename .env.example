# Copy this file to .env and fill only the provider you want to use.
APP_ENV=
LOG_LEVEL=
DATABASE_URL=

# Local OpenAI-compatible provider, such as LM Studio.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Optional OpenRouter primary provider. Leave blank to use the local provider only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
